{
    "name": "kevinpirnie/kp-support",
    "description": "A full-featured WordPress support ticket system with AJAX chat, threaded replies, departments, priorities, attachments, and a front-end customer portal.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Kevin Pirnie",
            "email": "me@kpirnie.com",
            "homepage": "https://kevinpirnie.com/"
        }
    ],
    "require": {
        "php": ">=8.2",
        "kevinpirnie/kpt-wpfieldframework": "^1.7"
    },
    "autoload": {
        "psr-4": {
            "KP\\Support\\": "source/src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable"
}